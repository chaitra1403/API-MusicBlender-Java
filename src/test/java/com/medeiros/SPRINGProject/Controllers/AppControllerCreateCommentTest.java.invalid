@ExtendWith(MockitoExtension.class)
public class AppControllerCreateCommentTest {
    @Mock
    private CommentsRepository CommentsRepo;
    @Mock
    private LogRepository Log;
    @Mock
    private LogModel Date;
    @InjectMocks
    private AppController appController;
    @BeforeEach
    public void setUp() {
        when(Date.getTimeNow()).thenReturn("2023-10-01T10:00:00"); // Mock current time
    }
    @Test
    @Tag("valid")
    public void createCommentSuccessfully() {
        String comment = "This is a test comment";
        int id = 1; // TODO: Change to a valid ID if necessary
        String result = appController.createComment(id, comment);
        verify(CommentsRepo, times(1)).save(any(CommentsModel.class));
        verify(Log, times(1)).save(any(LogModel.class));
        assertEquals(comment, result);
    }
    @Test
    @Tag("boundary")
    public void handleEmptyCommentString() {
        String comment = "";
        int id = 1; // TODO: Change to a valid ID if necessary
        String result = appController.createComment(id, comment);
        verify(CommentsRepo, times(1)).save(any(CommentsModel.class));
        verify(Log, times(1)).save(any(LogModel.class));
        assertEquals(comment, result);
    }
    @Test
    @Tag("invalid")
    public void handleNullCommentString() {
        String comment = null;
        int id = 1; // TODO: Change to a valid ID if necessary
        assertThrows(NullPointerException.class, () -> {
            appController.createComment(id, comment);
        });
        verify(CommentsRepo, times(0)).save(any(CommentsModel.class));
        verify(Log, times(0)).save(any(LogModel.class));
    }
    @Test
    @Tag("invalid")
    public void handleNegativeId() {
        String comment = "This is a test comment";
        int id = -1;
        assertThrows(IllegalArgumentException.class, () -> {
            appController.createComment(id, comment);
        });
        verify(CommentsRepo, times(0)).save(any(CommentsModel.class));
        verify(Log, times(0)).save(any(LogModel.class));
    }
    @Test
    @Tag("integration")
    public void verifyLogEntryCreation() {
        String comment = "This is a test comment";
        int id = 1; // TODO: Change to a valid ID if necessary
        appController.createComment(id, comment);
        verify(Log, times(1)).save(argThat(log -> 
            log.getUrl().equals("app/createComment/{id}") &&
            log.getApplicationName().equals("App") &&
            log.getTimeNow().equals("2023-10-01T10:00:00") // Corrected method name
        ));
    }
