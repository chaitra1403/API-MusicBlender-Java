    public void validMusicIdIncreasesCommentCount() {
        int musicId = 1; // TODO: Change to a valid ID if necessary
        MusicModel musicModel = mock(MusicModel.class);
        when(musicRepo.findById(musicId)).thenReturn(musicModel);
        when(musicModel.getNumberOfComents()).thenReturn(5);
        String result = appController.CommentMusicById(musicId);
        verify(musicModel).setNumberOfComents(6);
        verify(musicRepo).save(musicModel);
        assertEquals("Música Alterada!", result);
    }
