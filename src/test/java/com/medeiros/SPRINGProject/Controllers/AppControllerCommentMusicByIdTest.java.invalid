        verify(musicRepo, never()).save(any(MusicModel.class));
        assertEquals("Música Alterada!", result);
    }
    @Test
    @Tag("integration")
    public void logEntryCreatedOnComment() {
        int musicId = 1; // TODO: Change to a valid ID if necessary
        MusicModel musicModel = mock(MusicModel.class);
        when(musicRepo.findById(musicId)).thenReturn(musicModel);
        when(musicModel.getNumberOfComents()).thenReturn(5);
        appController.CommentMusicById(musicId);
        verify(Log).save(argThat(log -> 
            log instanceof LogModel && 
            ((LogModel) log).getUrl().equals("app/comment/{id}") &&
            ((LogModel) log).getAppName().equals("App") &&
            ((LogModel) log).getTimestamp() != null
        ));
    }
