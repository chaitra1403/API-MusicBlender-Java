package com.medeiros.SPRINGProject.Security;import com.medeiros.SPRINGProject.Models.User_Credentials;
import io.jsonwebtoken.Claims;
import io.jsonwebtoken.Jwts;
import io.jsonwebtoken.security.Keys;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.springframework.security.core.Authentication;
import java.nio.charset.StandardCharsets;
import java.security.Key;
import java.util.Date;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

public class JwtUtilIsValidTokenTest {
    private JwtUtil jwtUtil;
    private String jwtSecret = "mySecretKeymySecretKeymySecretKeymySecretKey"; // TODO: Change to actual secret key
    private Long jwtExpirationMilliseg = 3600000L; // TODO: Change to actual expiration time
    @BeforeEach
    public void setUp() {
        jwtUtil = new JwtUtil();
        // Removed direct access to private fields
        jwtUtil.setJwtSecret(jwtSecret);
        jwtUtil.setJwtExpirationMilliseg(jwtExpirationMilliseg);
    }
    @Test
    @Tag("valid")
    public void validTokenWithCorrectClaimsAndExpiration() {
        Authentication authentication = mock(Authentication.class);
        User_Credentials user = mock(User_Credentials.class);
        when(authentication.getPrincipal()).thenReturn(user);
        when(user.getUsername()).thenReturn("test@example.com");
        String token = jwtUtil.newToken(authentication);
        assertTrue(jwtUtil.isValidToken(token));
    }
    @Test
    @Tag("invalid")
    public void invalidTokenWithNullClaims() {
        String token = "invalidToken";
        assertFalse(jwtUtil.isValidToken(token));
    }
    @Test
    @Tag("invalid")
    public void expiredToken() {
        Authentication authentication = mock(Authentication.class);
        User_Credentials user = mock(User_Credentials.class);
        when(authentication.getPrincipal()).thenReturn(user);
        when(user.getUsername()).thenReturn("test@example.com");
        // Create a token with expiration date in the past
        Date pastDate = new Date(System.currentTimeMillis() - 1000);
        Key secretKey = Keys.hmacShaKeyFor(jwtSecret.getBytes(StandardCharsets.UTF_8));
        String token = Jwts.builder()
                .setSubject(user.getUsername())
                .setIssuedAt(new Date())
                .setExpiration(pastDate)
                .signWith(secretKey)
                .compact();
        assertFalse(jwtUtil.isValidToken(token));
    }
    @Test
    @Tag("invalid")
    public void tokenWithNullEmail() {
        // Create a token with null email
        Date futureDate = new Date(System.currentTimeMillis() + jwtExpirationMilliseg);
        Key secretKey = Keys.hmacShaKeyFor(jwtSecret.getBytes(StandardCharsets.UTF_8));
        String token = Jwts.builder()
                .setSubject(null)
                .setIssuedAt(new Date())
                .setExpiration(futureDate)
                .signWith(secretKey)
                .compact();
        assertFalse(jwtUtil.isValidToken(token));
    }
    @Test
    @Tag("invalid")
    public void tokenWithEmailButNoExpiration() {
        // Create a token with email but no expiration date
        Key secretKey = Keys.hmacShaKeyFor(jwtSecret.getBytes(StandardCharsets.UTF_8));
        String token = Jwts.builder()
                .setSubject("test@example.com")
                .setIssuedAt(new Date())
                .signWith(secretKey)
                .compact();
        assertFalse(jwtUtil.isValidToken(token));
    }
    @Test
    @Tag("boundary")
    public void tokenWithExpirationAtCurrentTime() {
        // Create a token with expiration date exactly at current time
        Date currentTime = new Date(System.currentTimeMillis());
        Key secretKey = Keys.hmacShaKeyFor(jwtSecret.getBytes(StandardCharsets.UTF_8));
        String token = Jwts.builder()
                .setSubject("test@example.com")
                .setIssuedAt(new Date())
                .setExpiration(currentTime)
                .signWith(secretKey)
                .compact();
        assertFalse(jwtUtil.isValidToken(token));
    }
}